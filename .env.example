# Copy to .env.local only when needed; never commit credentials.
# Mock mode is the default. Preview builds must remain mock.
APP_ENV=mock
# backend:start writes local URLs and generated keys to ignored .local/runtime.json.
# dev:local loads that file automatically. No hosted project linkage is needed.
# Future production deployment (separate approval) requires explicit public settings:
# APP_ENV=production
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# Existing production-only server settings (do not copy them into development):
# OPENAI_API_KEY=
# OPENAI_MODEL=
# SUPABASE_SECRET_KEY=
# CHEMWAYPOINT_AUTOMATION_TOKEN=
# CHEMWAYPOINT_AUTOMATION_USER_ID=
