    "backend:start": "node scripts/backend.cjs start",
    "backend:stop": "node scripts/backend.cjs stop",
    "backend:reset": "node scripts/backend.cjs reset",
    "backend:seed": "node scripts/backend.cjs seed",
    "backend:status": "node scripts/backend.cjs status",
    "test": "node scripts/test.cjs",
    "test:integration": "node scripts/integration.cjs",
    "build:companion": "node scripts/build-companion-bridge.cjs",
    "test:browser": "node --require ./tests/offline.cjs tests/browser/mock.cjs",
    "test:accessibility": "node --require ./tests/offline.cjs --test tests/browser-accessibility.cjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "2.117.2",
    "axe-core": "4.14.0",
    "jsdom": "26.1.0",
